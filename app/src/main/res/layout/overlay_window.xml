<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- Mini Controller Floating Bubble Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/overlay_container"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorSurface"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Drag Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Icon Rekam"
                    android:src="@drawable/ic_record" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Rekamin Dulu"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/overlay_close_btn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Hentikan Perekaman"
                    android:padding="2dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <!-- Live Timer & FPS Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/overlay_timer_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="@color/colorError"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/overlay_fps_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/ic_play_circle_bg"
                        android:backgroundTint="@color/colorPrimaryContainer"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="60 FPS"
                        android:textColor="@color/colorPrimary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/overlay_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="● Merekam Layar"
                    android:textColor="@color/textCaption"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Floating Control Actions Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingBottom="8dp">

                <!-- Pause/Resume Button -->
                <ImageView
                    android:id="@+id/btn_overlay_pause_resume"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Jeda / Lanjut"
                    android:padding="6dp"
                    android:src="@drawable/ic_pause" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <!-- Stop Recording Button -->
                <ImageView
                    android:id="@+id/btn_overlay_stop"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Hentikan"
                    android:padding="6dp"
                    android:src="@drawable/ic_record" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <!-- Open Home App -->
                <ImageView
                    android:id="@+id/btn_overlay_open_app"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Buka Rekamin"
                    android:padding="6dp"
                    android:src="@drawable/ic_home" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
