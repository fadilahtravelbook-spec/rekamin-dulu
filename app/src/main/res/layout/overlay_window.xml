<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_root_frame"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- ============================================================ -->
    <!-- MODE 1: COMPACT GAMER STEALTH PILL (Bola Melayang Mini Game) -->
    <!-- Snaps cleanly to screen edges, semi-translucent, non-intrusive-->
    <!-- ============================================================ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/overlay_bubble_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="#E610111D"
        app:cardCornerRadius="24dp"
        app:cardElevation="14dp"
        app:strokeColor="#556C5CE7"
        app:strokeWidth="1.2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <!-- Pulsing Record Glowing Beacon -->
            <ImageView
                android:id="@+id/overlay_bubble_pulse_dot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Status Rekaman Layar"
                android:src="@drawable/ic_record_beacon" />

            <!-- Live Digital Monospace Timer in Bubble -->
            <TextView
                android:id="@+id/overlay_bubble_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Divider Line -->
            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="6dp"
                android:background="#33FFFFFF" />

            <!-- Live FPS Chip in Bubble -->
            <TextView
                android:id="@+id/overlay_bubble_fps_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_pill"
                android:backgroundTint="#2600B894"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="60 FPS"
                android:textColor="#00B894"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <!-- Expand Chevron Icon -->
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Buka Panel Gamer HUD"
                android:src="@drawable/ic_next"
                app:tint="#88FFFFFF" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ============================================================ -->
    <!-- MODE 2: EXPANDED PRO GAMER HUD & STUDIO CONTROLLER           -->
    <!-- Frosted Cyber Dark Glass Aesthetic, Translucent & Ergonomic -->
    <!-- ============================================================ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/overlay_container"
        android:layout_width="268dp"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:cardBackgroundColor="#F2121320"
        app:cardCornerRadius="22dp"
        app:cardElevation="18dp"
        app:strokeColor="#2EFFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Header Drag Bar (Dedicated touch target for dragging) -->
            <LinearLayout
                android:id="@+id/overlay_header_drag_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#241B1C2E"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/overlay_pulse_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Status Rekam"
                    android:src="@drawable/ic_record_beacon" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Rekamin • Game HUD"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- REC / PAUSE Live Pill -->
                <TextView
                    android:id="@+id/overlay_header_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_pill"
                    android:backgroundTint="#33FF4757"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="REC"
                    android:textColor="#FF4757"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <!-- Transparency / Stealth Mode Toggle (Cycles 100% -> 60% -> 35%) -->
                <ImageView
                    android:id="@+id/btn_overlay_transparency"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Ubah Transparansi / Mode Stealth Gamer"
                    android:focusable="true"
                    android:padding="5dp"
                    android:src="@drawable/ic_visibility"
                    app:tint="#AAFFFFFF" />

                <!-- Minimize Button (collapses to stealth bubble) -->
                <ImageView
                    android:id="@+id/btn_overlay_minimize"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Kecilkan ke Bola Melayang"
                    android:focusable="true"
                    android:padding="5dp"
                    android:src="@drawable/ic_collapse"
                    app:tint="#AAFFFFFF" />

                <!-- Close / Hide Overlay Button -->
                <ImageView
                    android:id="@+id/overlay_close_btn"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Tutup Overlay"
                    android:focusable="true"
                    android:padding="5dp"
                    android:src="@drawable/ic_close"
                    app:tint="#88FFFFFF" />
            </LinearLayout>

            <!-- 2. Live Timer, FPS & Telemetry Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="9dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Live Digital Monospace Timer -->
                    <TextView
                        android:id="@+id/overlay_timer_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="00:00"
                        android:textColor="#FF4757"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Live FPS Badge (Dynamic Green/Cyan/Orange) -->
                    <TextView
                        android:id="@+id/overlay_fps_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_pill"
                        android:backgroundTint="#2600B894"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="60 FPS"
                        android:textColor="#00B894"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <!-- Quality / Resolution Badge -->
                    <TextView
                        android:id="@+id/overlay_quality_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_pill"
                        android:backgroundTint="#2E6C5CE7"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="3dp"
                        android:text="1080p"
                        android:textColor="#A29BFE"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Recording Status & Audio Line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/overlay_status_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="● Merekam Layar Aktif"
                        android:textColor="#9E9EA8"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/overlay_audio_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎙️ Mic Aktif"
                        android:textColor="#8E82F3"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Penilai FPS & Evaluasi Performa Game -->
            <LinearLayout
                android:id="@+id/box_fps_evaluation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="5dp"
                android:background="@drawable/bg_telemetry_box_gamer"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Header Evaluasi & Skor -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.04"
                        android:text="PENILAI FPS &amp; GAME HEALTH"
                        android:textColor="#7A7B8E"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />

                    <!-- Skor Penilai FPS (A+, A, B, C) -->
                    <TextView
                        android:id="@+id/overlay_fps_rating_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_pill"
                        android:backgroundTint="#2600B894"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="A+ SANGAT MULUS"
                        android:textColor="#00B894"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Metrik Sinkronisasi FPS App & Layar -->
                <TextView
                    android:id="@+id/overlay_fps_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Target: 60 FPS • Layar: 60Hz • Stabilitas: 100%"
                    android:textColor="#DCDCE6"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Keterangan Advice / Status Game -->
                <TextView
                    android:id="@+id/overlay_fps_advice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Sinkron: Frame rate stabil untuk rekaman game HD (100% optimal)."
                    android:textColor="#888998"
                    android:textSize="9sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:background="#1FFFFFFF" />

            <!-- 4. Floating Tools Row 1 (Primary Actions) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <!-- Tool 1: Jeda / Lanjut -->
                <LinearLayout
                    android:id="@+id/action_overlay_pause_wrapper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="5dp">

                    <ImageView
                        android:id="@+id/btn_overlay_pause_resume"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_chip_pill"
                        android:backgroundTint="#2E6C5CE7"
                        android:contentDescription="Jeda atau Lanjut Rekaman"
                        android:padding="9dp"
                        android:src="@drawable/ic_pause"
                        app:tint="#A29BFE" />

                    <TextView
                        android:id="@+id/label_overlay_pause"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Jeda"
                        android:textColor="#D0D0DC"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tool 2: Hentikan & Simpan -->
                <LinearLayout
                    android:id="@+id/action_overlay_stop_wrapper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="5dp">

                    <ImageView
                        android:id="@+id/btn_overlay_stop"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_chip_pill"
                        android:backgroundTint="#33FF4757"
                        android:contentDescription="Hentikan dan Simpan"
                        android:padding="9dp"
                        android:src="@drawable/ic_stop"
                        app:tint="#FF4757" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Selesai"
                        android:textColor="#FF6B6B"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tool 3: Screenshot Cepat -->
                <LinearLayout
                    android:id="@+id/action_overlay_screenshot_wrapper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="5dp">

                    <ImageView
                        android:id="@+id/btn_overlay_screenshot"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_chip_pill"
                        android:backgroundTint="#24FFFFFF"
                        android:contentDescription="Ambil Tangkapan Layar Cepat"
                        android:padding="9dp"
                        android:src="@drawable/ic_camera"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Screenshot"
                        android:textColor="#D0D0DC"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Floating Tools Row 2 (Auxiliary Interactive Tools) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="8dp">

                <!-- Tool 4: Toggle Mikrofon Cepat -->
                <LinearLayout
                    android:id="@+id/action_overlay_mic_wrapper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:id="@+id/btn_overlay_mic"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_pill"
                        android:backgroundTint="#2E6C5CE7"
                        android:contentDescription="Nyalakan atau Matikan Mikrofon"
                        android:padding="8dp"
                        android:src="@drawable/ic_mic"
                        app:tint="#A29BFE" />

                    <TextView
                        android:id="@+id/label_overlay_mic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mic On"
                        android:textColor="#D0D0DC"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- Tool 5: Toggle Facecam Kamera Wajah -->
                <LinearLayout
                    android:id="@+id/action_overlay_facecam_wrapper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:id="@+id/btn_overlay_facecam"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_pill"
                        android:backgroundTint="#24FFFFFF"
                        android:contentDescription="Kamera Wajah Facecam"
                        android:padding="8dp"
                        android:src="@drawable/ic_video"
                        app:tint="#AAAAAA" />

                    <TextView
                        android:id="@+id/label_overlay_facecam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Facecam"
                        android:textColor="#D0D0DC"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- Tool 6: Buka Aplikasi Rekamin Dulu -->
                <LinearLayout
                    android:id="@+id/action_overlay_home_wrapper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:id="@+id/btn_overlay_open_app"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_pill"
                        android:backgroundTint="#24FFFFFF"
                        android:contentDescription="Buka Dashboard Rekamin Dulu"
                        android:padding="8dp"
                        android:src="@drawable/ic_home"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Aplikasi"
                        android:textColor="#D0D0DC"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
