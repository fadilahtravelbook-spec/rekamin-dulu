<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A12">

    <!-- FULLSCREEN VIDEO VIEW -->
    <VideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TOP BAR OVERLAY (Edge-to-Edge with Inset Support) -->
    <RelativeLayout
        android:id="@+id/player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D90E0F1A"
        android:elevation="12dp"
        android:minHeight="56dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back / Close Button with tactile pill -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_player_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="#26FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/btn_player_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Tutup Pemutar"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Video Title & Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="12dp"
            android:layout_toStartOf="@id/layout_player_top_actions"
            android:layout_toEndOf="@id/card_player_back"
            android:orientation="vertical">

            <TextView
                android:id="@+id/player_video_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="Rekaman Layar"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_video_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Pemutar Video Rekamin Dulu"
                android:textColor="#A2A7BD"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Right Side Quick Actions (Speed & Share) -->
        <LinearLayout
            android:id="@+id/layout_player_top_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_playback_speed"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:minHeight="34dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="⚡ 1.0x"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                app:backgroundTint="#26FFFFFF"
                app:cornerRadius="17dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="#26FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/btn_player_share"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Bagikan Video"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_share"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </RelativeLayout>

    <!-- BOTTOM CONTROLS DOCK (Edge-to-Edge with Inset Support) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/player_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#E60D0E1A"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:strokeColor="#2EFFFFFF"
        app:strokeWidth="1.2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- TIMESTAMPS ROW & PROGRESS BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- SEEKBAR -->
                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:paddingHorizontal="12dp"
                    android:progress="0"
                    android:progressTint="@color/colorPrimary"
                    android:thumbTint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="00:00"
                    android:textColor="#A2A7BD"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- PRIMARY MEDIA PLAYBACK CONTROLS (Rewind, Play/Pause, Forward) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Rewind 10s -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardBackgroundColor="#22FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/btn_rewind"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Mundur 10 detik"
                        android:focusable="true"
                        android:padding="11dp"
                        android:src="@drawable/ic_previous"
                        app:tint="#FFFFFF" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Big Glowing Play / Pause Primary Button -->
                <FrameLayout
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_marginHorizontal="24dp"
                    android:background="@drawable/ic_play_circle_bg"
                    android:backgroundTint="#336C5CE7">

                    <ImageView
                        android:id="@+id/play_pause_btn"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:background="@drawable/ic_play_circle_bg"
                        android:backgroundTint="@color/colorPrimary"
                        android:clickable="true"
                        android:contentDescription="Putar atau Jeda Video"
                        android:focusable="true"
                        android:padding="14dp"
                        android:src="@drawable/ic_pause"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <!-- Forward 10s -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardBackgroundColor="#22FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/btn_forward"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Maju 10 detik"
                        android:focusable="true"
                        android:padding="11dp"
                        android:src="@drawable/ic_next"
                        app:tint="#FFFFFF" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- DIVIDER LINE -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#1AFFFFFF" />

            <!-- ACTION PILLS ROW (Potong, Ekstrak Audio, Eksternal) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Potong Video Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_player_trim_shortcut"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="0dp"
                    android:text="✂️ Potong"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#26FFFFFF"
                    app:cornerRadius="20dp"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp" />

                <!-- Ekstrak Audio Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_player_extract_audio"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1.2"
                    android:minHeight="40dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="0dp"
                    android:text="🎵 Ekstrak Audio"
                    android:textColor="@color/colorPrimaryLight"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#286C5CE7"
                    app:cornerRadius="20dp"
                    app:strokeColor="#556C5CE7"
                    app:strokeWidth="1dp" />

                <!-- Buka Eksternal Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_player_open_external"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="0.9"
                    android:minHeight="40dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="0dp"
                    android:text="↗️ Buka"
                    android:textColor="#D0D0DC"
                    android:textSize="11.5sp"
                    app:backgroundTint="#1AFFFFFF"
                    app:cornerRadius="20dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
