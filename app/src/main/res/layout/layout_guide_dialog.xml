<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorSurface"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TITLE & ICON -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Ikon Panduan"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Panduan &amp; Tata Cara"
                    android:textColor="@color/textTitle"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Langkah sebelum merekam layar &amp; contoh nyata"
                    android:textColor="@color/textCaption"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/colorCardBackground" />

        <!-- SECTION 1: TATA CARA SEBELUM MULAI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 TATA CARA SEBELUM MULAI MEREKAM:"
            android:textColor="@color/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/ic_play_circle_bg"
                android:backgroundTint="@color/colorPrimary"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih Sumber Suara (Audio)"
                    android:textColor="@color/textTitle"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aktifkan Mikrofon (ON) untuk suara Anda, dan Audio Game (ON) untuk suara internal game/aplikasi."
                    android:textColor="@color/textBody"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/ic_play_circle_bg"
                android:backgroundTint="@color/colorPrimary"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atur Kualitas Video"
                    android:textColor="@color/textTitle"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih preset resolusi (1080p FHD 60FPS untuk hasil maksimal, atau 720p HD untuk hemat memori)."
                    android:textColor="@color/textBody"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/ic_play_circle_bg"
                android:backgroundTint="@color/colorPrimary"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tekan Tombol 'Start Recording'"
                    android:textColor="@color/textTitle"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Setelah hitung mundur (3 detik), dialog persetujuan sistem Android akan muncul. Tekan 'Mulai Sekarang' (Start now)."
                    android:textColor="@color/textBody"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/ic_play_circle_bg"
                android:backgroundTint="@color/colorPrimary"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kontrol &amp; Berhenti Merekam"
                    android:textColor="@color/textTitle"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tarik panel notifikasi atas kapan saja untuk Jeda atau Hentikan &amp; Simpan. Video otomatis tersimpan di Galeri!"
                    android:textColor="@color/textBody"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECTION 2: CONTOH PENGGUNAAN NYATA -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/colorCardBackground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 CONTOH PENGGUNAAN (MEREKAM GAMEPLAY &amp; TUTORIAL):"
            android:textColor="@color/colorSuccess"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/colorCardBackground"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="Skenario: Anda ingin merekam gameplay Mobile Legends / Free Fire atau membuat video tutorial aplikasi untuk YouTube / TikTok.\n\n1. Buka Rekamin Dulu, pastikan Mikrofon: ON &amp; Audio Game: ON.\n2. Tekan 'Start Recording', lalu setujui tangkap layar.\n3. Langsung buka game Anda dan mainkan seperti biasa.\n4. Saat match selesai, geser bilah notifikasi ke bawah dan ketuk tombol 'Hentikan &amp; Simpan'.\n5. Klip video tersimpan di Galeri dan siap dipotong (Trim) atau dibagikan!"
                    android:textColor="@color/textBody"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BUTTON CLOSE / UNDERSTAND -->
        <Button
            android:id="@+id/btn_close_guide"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/colorPrimary"
            android:text="Saya Mengerti, Siap Merekam"
            android:textColor="@color/colorOnPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="24dp" />

    </LinearLayout>
</ScrollView>
