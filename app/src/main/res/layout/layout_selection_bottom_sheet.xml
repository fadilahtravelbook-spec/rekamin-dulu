<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Bottom sheet drag handle indicator -->
    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_chip_pill"
        android:backgroundTint="@color/colorBorder" />

    <!-- HEADER TITLE & ICON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip_pill"
            android:backgroundTint="@color/colorPrimaryContainer">

            <ImageView
                android:id="@+id/img_selection_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Ikon Pengaturan"
                android:src="@drawable/ic_video"
                app:tint="@color/colorPrimary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_selection_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Resolusi Video"
                android:textColor="@color/textTitle"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_selection_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pilih resolusi rekaman sesuai kapasitas &amp; performa"
                android:textColor="@color/textCaption"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.2dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="14dp"
        android:background="@color/colorBorder" />

    <!-- SCROLLABLE OPTIONS CONTAINER -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:maxHeight="420dp"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/container_selection_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <!-- CANCEL / CLOSE BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_selection_cancel"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:minHeight="48dp"
        android:text="Tutup / Batal"
        android:textColor="@color/colorOnSurface"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/colorSurfaceVariant"
        app:cornerRadius="16dp"
        app:elevation="0dp"
        app:strokeColor="@color/colorBorder"
        app:strokeWidth="1dp" />
</LinearLayout>
