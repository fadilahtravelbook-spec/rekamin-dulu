<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorSurface"
    android:padding="16dp">

    <!-- Icon rekaman -->
    <ImageView
        android:id="@+id/notification_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_record"
        android:contentDescription="Status rekaman"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Teks status -->
    <TextView
        android:id="@+id/notification_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Merekam..."
        android:textColor="@color/textTitle"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/notification_icon"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Timer durasi rekaman -->
    <TextView
        android:id="@+id/notification_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/textCaption"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/notification_status"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Kontrol melayang (mini) -->
    <ImageView
        android:id="@+id/notification_overlay_btn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_close_mini"
        android:contentDescription="Sembunyikan kontrol"
        app:tint="@color/textCaption"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>