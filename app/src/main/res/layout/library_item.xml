<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:cardview="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    cardview:cardBackgroundColor="@color/colorSurface"
    cardview:cardCornerRadius="16dp"
    cardview:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Thumbnail -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="64dp">

                <ImageView
                    android:id="@+id/thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/colorBackground"
                    android:contentDescription="Thumbnail rekaman"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="Play"
                    android:src="@drawable/ic_video" />
            </FrameLayout>

            <!-- Info Kontainer -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Rekaman_20241025_01"
                    android:textColor="@color/textTitle"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12.4 MB • 1080p"
                        android:textColor="@color/textCaption"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Action Bar Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Primary Play Button -->
                <Button
                    android:id="@+id/btn_item_play"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="14dp"
                    android:text="▶ Putar"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    cardview:backgroundTint="@color/colorPrimary"
                    cardview:cornerRadius="18dp" />

                <!-- Primary Delete Button -->
                <Button
                    android:id="@+id/btn_item_delete"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:text="🗑️ Hapus"
                    android:textColor="@color/colorError"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Share Button -->
                <Button
                    android:id="@+id/btn_item_share"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="📤 Bagikan"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp" />

                <!-- Rename Button -->
                <Button
                    android:id="@+id/btn_item_rename"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="✏️ Ubah Nama"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp" />

                <!-- Edit / Trim Button -->
                <Button
                    android:id="@+id/btn_item_edit"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="10dp"
                    android:text="✂️ Potong"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp" />

                <!-- Extract Audio Button -->
                <Button
                    android:id="@+id/btn_item_extract_audio"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="10dp"
                    android:text="🎵 Ekstrak Audio"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
</androidx.cardview.widget.CardView>
