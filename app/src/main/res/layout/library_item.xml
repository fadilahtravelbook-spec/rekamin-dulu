<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:cardview="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="6dp"
    cardview:cardBackgroundColor="@color/colorSurface"
    cardview:cardCornerRadius="16dp"
    cardview:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Rounded Thumbnail Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="104dp"
                android:layout_height="72dp"
                cardview:cardCornerRadius="12dp"
                cardview:cardElevation="0dp"
                cardview:cardBackgroundColor="@color/colorSurfaceVariant">

                <ImageView
                    android:id="@+id/thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Thumbnail rekaman"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ic_play_circle_bg"
                    android:backgroundTint="#80000000"
                    android:contentDescription="Play"
                    android:padding="5dp"
                    android:src="@drawable/ic_play_arrow" />
            </androidx.cardview.widget.CardView>

            <!-- Video Metadata Info Container -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Rekaman Video"
                    android:textColor="@color/textTitle"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="00:00 • 0.0 MB • 1080p\n01 Jan 2026"
                    android:textColor="@color/textCaption"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Bar Row ScrollView -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Primary Play Button -->
                <Button
                    android:id="@+id/btn_item_play"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="@color/colorPrimary"
                    android:paddingHorizontal="14dp"
                    android:text="▶ Putar"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    cardview:cornerRadius="20dp" />

                <!-- Trim Button -->
                <Button
                    android:id="@+id/btn_item_edit"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="12dp"
                    android:text="✂️ Potong"
                    android:textSize="11sp"
                    cardview:cornerRadius="20dp" />

                <!-- Extract Audio Button -->
                <Button
                    android:id="@+id/btn_item_extract_audio"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="12dp"
                    android:text="🎵 Ekstrak Audio"
                    android:textSize="11sp"
                    cardview:cornerRadius="20dp" />

                <!-- Share Button -->
                <Button
                    android:id="@+id/btn_item_share"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="12dp"
                    android:text="📤 Bagikan"
                    android:textSize="11sp"
                    cardview:cornerRadius="20dp" />

                <!-- Rename Button -->
                <Button
                    android:id="@+id/btn_item_rename"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="12dp"
                    android:text="✏️ Ubah Nama"
                    android:textSize="11sp"
                    cardview:cornerRadius="20dp" />

                <!-- Delete Button -->
                <Button
                    android:id="@+id/btn_item_delete"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:paddingHorizontal="10dp"
                    android:text="🗑️ Hapus"
                    android:textColor="@color/colorError"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
</androidx.cardview.widget.CardView>
