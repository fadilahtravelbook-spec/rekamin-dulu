<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp"
            app:strokeColor="@color/colorBorder"
            app:strokeWidth="1.2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="20dp">

                <!-- 1. TITLE BAR -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/btn_close_dialog"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="Ikon Kesiapan"
                                android:src="@drawable/ic_device"
                                app:tint="@color/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Kesiapan Hardware"
                                android:textColor="@color/textTitle"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Diagnostik Performa &amp; Benchmark Rekam Layar HP"
                            android:textColor="@color/textCaption"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_close_dialog"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Tutup Dialog"
                        android:focusable="true"
                        android:padding="8dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/textCaption" />
                </RelativeLayout>

                <!-- 2. READINESS SCORE HERO CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/colorCardBackground"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="SKOR KELAYAKAN HARDWARE"
                            android:textColor="@color/textCaption"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_dialog_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:letterSpacing="-0.02"
                            android:text="95 / 100"
                            android:textColor="@color/colorPrimaryLight"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_dialog_status_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_chip_pill"
                            android:backgroundTint="@color/colorSuccess"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="5dp"
                            android:text="S+ ESPORTS READY (OPTIMAL)"
                            android:textColor="@color/colorOnPrimary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/progress_dialog_score"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="7dp"
                            android:layout_marginTop="12dp"
                            android:max="100"
                            android:progress="95"
                            android:progressTint="@color/colorPrimary" />

                        <!-- High-Contrast Recommendation Box -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_telemetry_box"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/text_dialog_recommendation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="3dp"
                                android:text="💡 Rekomendasi: 1080p FHD @ 60 FPS dengan audio game jernih dan mulus."
                                android:textColor="@color/textTitle"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. INTERACTIVE HARDWARE ENCODER BENCHMARK CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_hardware_benchmark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/colorSurfaceVariant"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="Benchmark Ikon"
                                android:src="@drawable/ic_speed"
                                app:tint="@color/colorPrimary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tes Benchmark Encoder Hardware"
                                    android:textColor="@color/textTitle"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Uji latensi riil chip video HP Anda (stress test 2 detik)"
                                    android:textColor="@color/textCaption"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Benchmark Action Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_run_benchmark"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:text="⚡ JALANKAN TES BENCHMARK ENCODER"
                            android:textColor="@color/colorOnPrimary"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/colorPrimary"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_play_arrow"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="16dp" />

                        <!-- Benchmark Progress Spinner -->
                        <ProgressBar
                            android:id="@+id/progress_benchmark"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="8dp"
                            android:indeterminate="true"
                            android:visibility="gone" />

                        <!-- Benchmark Result Badge -->
                        <LinearLayout
                            android:id="@+id/layout_benchmark_result"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_telemetry_box"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="Status Lolos"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/colorSuccess" />

                            <TextView
                                android:id="@+id/text_benchmark_result"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="Lolos: Encoder HW responsif (60 FPS • Latensi 8.2ms)"
                                android:textColor="@color/colorSuccess"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. THREE PRESET RECOMMENDATIONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Preset"
                        android:src="@drawable/ic_tune"
                        app:tint="@color/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Pilihan Preset Siap Pakai (1-Klik Terapkan)"
                        android:textColor="@color/textTitle"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Preset 1: Mode Gaming Pro (Flagship) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_preset_gaming"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="14dp"
                    android:text="🎮 Mode Gaming Pro • 1080p 60 FPS (12 Mbps)"
                    android:textColor="@color/textTitle"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorSurfaceVariant"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/colorPrimary"
                    app:strokeWidth="1.2dp" />

                <!-- Preset 2: Mode Seimbang -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_preset_balanced"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="14dp"
                    android:text="⚡ Mode Seimbang • 720p 60 FPS (8 Mbps)"
                    android:textColor="@color/textTitle"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorSurfaceVariant"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1dp" />

                <!-- Preset 3: Mode Hemat Baterai -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_preset_battery"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="14dp"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="14dp"
                    android:text="🔋 Mode Hemat Baterai • 720p 30 FPS (4 Mbps)"
                    android:textColor="@color/textTitle"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorSurfaceVariant"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1dp" />

                <!-- Legacy apply button for backward compatibility -->
                <Button
                    android:id="@+id/btn_apply_recommendation"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- 5. DETAILED SPECS CARD (NO OVERLAPS: WEIGHTED HORIZONTAL COLUMNS) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/colorCardBackground"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="Ikon Sensor"
                                android:src="@drawable/ic_device"
                                app:tint="@color/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Rincian Komponen &amp; Sensor Lengkap"
                                android:textColor="@color/textTitle"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 1. Perangkat -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Model"
                                android:src="@drawable/ic_device"
                                app:tint="@color/colorPrimary" />

                            <TextView
                                android:layout_width="118dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Model Perangkat"
                                android:textColor="@color/textCaption"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/text_diag_device"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="Google Pixel (Android 14)"
                                android:textColor="@color/textTitle"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="3dp"
                            android:background="@color/colorBorder" />

                        <!-- 2. CPU / SoC -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="CPU"
                                android:src="@drawable/ic_cpu"
                                app:tint="@color/colorPrimary" />

                            <TextView
                                android:layout_width="118dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Chipset / CPU"
                                android:textColor="@color/textCaption"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/text_diag_cpu"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="Octa-Core ARM64 (8 Inti)"
                                android:textColor="@color/textTitle"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="3dp"
                            android:background="@color/colorBorder" />

                        <!-- 3. RAM -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="RAM"
                                android:src="@drawable/ic_ram"
                                app:tint="@color/colorPrimary" />

                            <TextView
                                android:layout_width="118dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Kapasitas RAM"
                                android:textColor="@color/textCaption"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/text_diag_ram"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="4.0 GB (2.1 GB Bebas)"
                                android:textColor="@color/textTitle"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="3dp"
                            android:background="@color/colorBorder" />

                        <!-- 4. Storage & Estimation -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Storage"
                                android:src="@drawable/ic_storage"
                                app:tint="@color/colorPrimary" />

                            <TextView
                                android:layout_width="118dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Sisa Ruang"
                                android:textColor="@color/textCaption"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/text_diag_storage"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="28.4 GB (~5.2 Jam Rekam)"
                                android:textColor="@color/colorSuccess"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="3dp"
                            android:background="@color/colorBorder" />

                        <!-- 5. Layar Fisik & Hz -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Layar"
                                android:src="@drawable/ic_video"
                                app:tint="@color/colorPrimary" />

                            <TextView
                                android:layout_width="118dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Layar &amp; Refresh"
                                android:textColor="@color/textCaption"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/text_diag_screen"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="1080 x 2400 (60 Hz)"
                                android:textColor="@color/textTitle"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="3dp"
                            android:background="@color/colorBorder" />

                        <!-- 6. Codec Hardware -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Codec"
                                android:src="@drawable/ic_codec"
                                app:tint="@color/colorPrimary" />

                            <TextView
                                android:layout_width="118dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Encoder Hardware"
                                android:textColor="@color/textCaption"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/text_diag_codec"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="H.264 AVC (Akselerasi HW)"
                                android:textColor="@color/textTitle"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="3dp"
                            android:background="@color/colorBorder" />

                        <!-- 7. Audio System -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Audio"
                                android:src="@drawable/ic_mic"
                                app:tint="@color/colorPrimary" />

                            <TextView
                                android:layout_width="118dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Audio Internal"
                                android:textColor="@color/textCaption"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/text_diag_audio"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="Didukung (Playback Capture)"
                                android:textColor="@color/colorSuccess"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="3dp"
                            android:background="@color/colorBorder" />

                        <!-- 8. Baterai & Suhu -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Baterai"
                                android:src="@drawable/ic_battery"
                                app:tint="@color/colorPrimary" />

                            <TextView
                                android:layout_width="118dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Status Baterai"
