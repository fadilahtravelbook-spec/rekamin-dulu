<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context="com.bangdillah.rekamindulu.library.LibraryActivity">

    <!-- Header Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_setting_icon_box">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Logo Rekamin"
                android:src="@drawable/ic_library"
                app:tint="@color/colorPrimary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Galeri Rekaman Video"
                android:textColor="@color/textTitle"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_library_stats_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Memuat daftar rekaman..."
                android:textColor="@color/textCaption"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tambah_rekam"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minHeight="38dp"
            android:paddingHorizontal="14dp"
            android:text="+ Rekam Baru"
            android:textColor="@color/colorOnPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="14dp" />

    </LinearLayout>

    <!-- ACTIVE RECORDING PERSISTENT INDICATOR -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_library_recording_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/colorError"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_record"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/text_library_rec_timer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="🔴 Perekaman Layar Aktif • 00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_library_stop_rec"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minHeight="34dp"
                android:text="Stop"
                android:textColor="@color/colorError"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SEARCH & FILTER BAR -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_search_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/colorSurface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/card_library_recording_indicator"
        app:strokeColor="@color/colorBorder"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Cari"
                android:src="@drawable/ic_search"
                app:tint="@color/textCaption" />

            <EditText
                android:id="@+id/et_search_library"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Cari nama rekaman..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/textTitle"
                android:textColorHint="@color/textCaption"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btn_clear_search"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Hapus Pencarian"
                android:padding="6dp"
                android:src="@drawable/ic_clear"
                android:visibility="gone"
                app:tint="@color/textCaption" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="6dp"
                android:background="@color/colorBorder" />

            <ImageView
                android:id="@+id/btn_sort_library"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Urutkan Rekaman"
                android:padding="6dp"
                android:src="@drawable/ic_sort"
                app:tint="@color/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- HORIZONTAL FILTER CHIPS -->
    <HorizontalScrollView
        android:id="@+id/scroll_filter_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/card_search_bar">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Semua"
                android:textColor="@color/color_filter_chip_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_filter_game"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="🎮 Rekaman Game"
                android:textColor="@color/color_filter_chip_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_filter_recent"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="📁 Hari Ini"
                android:textColor="@color/color_filter_chip_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_filter_long"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_filter_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="⏱️ &gt; 1 Menit"
                android:textColor="@color/color_filter_chip_text"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Empty State View -->
    <ScrollView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_library"
        app:layout_constraintTop_toBottomOf="@id/scroll_filter_chips">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="32dp">

            <ImageView
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:contentDescription="Ilustrasi galeri kosong"
                android:src="@drawable/ic_empty_video_gallery" />

            <TextView
                android:id="@+id/text_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Belum Ada Hasil Rekaman"
                android:textColor="@color/textTitle"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Mulai rekam layar gameplay atau aplikasi Anda sekarang! Hasil video MP4 berkualitas tinggi akan otomatis tersimpan di sini."
                android:textColor="@color/textCaption"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_start"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:minHeight="44dp"
                    android:paddingHorizontal="16dp"
                    android:text="🔴 Mulai Merekam"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorError"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_demo"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:paddingHorizontal="16dp"
                    android:text="✨ Buat Video Demo"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorPrimaryContainer"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <!-- Friendly Tip Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Fitur Lengkap Galeri Rekamin"
                        android:textColor="@color/textTitle"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="• Putar rekaman dengan pemutar video bawaan\n• Potong durasi (trim) bagian awal &amp; akhir video\n• Ekstrak audio rekaman menjadi format suara terpisah\n• Bagikan langsung ke WhatsApp, YouTube, atau sosmed"
                        android:textColor="@color/textCaption"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- RecyclerView daftar rekaman -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/library_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="84dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_library"
        app:layout_constraintTop_toBottomOf="@id/scroll_filter_chips" />

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_library"
        style="@style/Widget.App.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        app:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
